---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getWorks } from '../data/works';
import { HERO_WIDTH, optimizedVariantUrl } from '../lib/image-assets.mjs';

const works = getWorks();
const heroImage = optimizedVariantUrl('/images/HOME.jpg', HERO_WIDTH);
---

<BaseLayout
  title="Home"
  description="P.H. — Photography and travel projects."
>
  <!-- Fixed transparent nav — exact match to lin-zhaoye-photography.html -->
  <header class="topnav-fixed" data-od-id="topnav">
    <div class="topnav-fixed-inner">
      <nav aria-label="Primary navigation">
        <a href="/" class="nav-home" aria-current="page">HOME</a>
        <a href="/works" class="nav-work">WORK</a>
        <a href="/about" class="nav-about">ABOUT</a>
      </nav>
    </div>
  </header>

  <main id="content">
    <!-- ── Hero ── -->
    <section class="container home-stage" data-od-id="home-hero" style={`background-color: var(--bg); background-image: var(--hero-overlay), url('${heroImage}'); background-size: auto, cover; background-position: center, center; background-repeat: no-repeat, no-repeat;`}>
      <div class="hero-core">
        <h1 class="sr-only">Photography projects</h1>
        <nav aria-label="Portfolio titles" class="titles-nav">
          {works.map((w, i) => (
            <a href={`/works#${i}`}>{w.title}</a>
          ))}
        </nav>
      </div>
    </section>
  </main>

  <Footer pageLabel="Photography" tagline="P.H. — rooms, thresholds, peripheral light" />

  <!-- Handoff veil: fades in as the titles slide out, so the old page never
       reappears bare while the browser loads /works -->
  <div class="handoff-veil" aria-hidden="true"></div>
</BaseLayout>

<style>
  /* ── Fixed transparent nav ── */
  .topnav-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background: transparent;
    background-image: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
  }

  .topnav-fixed-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 68px;
    padding-inline: var(--gutter);
  }

  .topnav-fixed nav {
    display: flex;
    position: fixed;
    top: 0;
    /* leave room for the fixed theme-toggle icon at the far right */
    right: calc(var(--gutter) + 56px);
    z-index: 21;
    height: 68px;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .topnav-fixed nav a {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .topnav-fixed nav a[aria-current="page"],
  .topnav-fixed nav a:hover {
    color: var(--fg);
  }

  /* ── Home stage hero ── */
  .home-stage {
    min-height: 100svh;
    padding-top: calc(68px + clamp(34px, 5vw, 82px));
    padding-bottom: clamp(34px, 5vw, 82px);
    background-attachment: scroll, fixed;
    /* fade in on arrival, fade out on the home→works handoff */
    animation: hero-in 0.6s ease backwards;
    transition: opacity 0.42s ease;
  }

  @keyframes hero-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .home-stage.is-fading {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-stage {
      animation: none;
      transition: none;
    }
  }

  .titles-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(16px, 2vw, 26px);
    width: min(70vw, 860px);
    max-width: 100%;
    padding-top: 4px;
  }

  .titles-nav a {
    display: block;
    width: fit-content;
    max-width: calc(100% - var(--title-offset));
    margin-inline-start: var(--title-offset);
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.6vw, 24px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    line-height: 1.35;
    text-align: left;
    text-wrap: balance;
    text-decoration: none;
    text-shadow: 0 1px 8px color-mix(in oklch, var(--bg) 55%, transparent);
  }

  .titles-nav a:nth-child(7n + 1) { --title-offset: 0%; }
  .titles-nav a:nth-child(7n + 2) { --title-offset: 15%; }
  .titles-nav a:nth-child(7n + 3) { --title-offset: 4%; }
  .titles-nav a:nth-child(7n + 4) { --title-offset: 32%; }
  .titles-nav a:nth-child(7n + 5) { --title-offset: 12%; }
  .titles-nav a:nth-child(7n + 6) { --title-offset: 24%; }
  .titles-nav a:nth-child(7n + 7) { --title-offset: 2%; }

  .titles-nav a:hover,
  .titles-nav a:focus-visible {
    color: var(--muted);
  }

  .titles-nav a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 6px;
  }

  .hero-core {
    min-width: 0;
  }

  /* ── Responsive: 620px ── */
  @media (max-width: 620px) {
    :root {
      --gutter: 20px;
    }

    .titles-nav {
      width: 100%;
      gap: 20px;
    }

    .titles-nav a {
      font-size: clamp(13px, 3.2vw, 18px);
      letter-spacing: 0.04em;
    }

    .home-stage {
      background-attachment: scroll;
    }
  }

  /* ── Handoff veil: covers the page while /works loads ── */
  .handoff-veil {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.36s ease 0.04s;
  }

  .handoff-veil.on {
    opacity: 1;
  }

  /* ── Handoff to /works: project titles slide left ── */
  .titles-nav a {
    transition: transform 0.32s ease, opacity 0.32s ease, color 0.15s ease;
  }

  .titles-nav.is-leaving a {
    transform: translateX(-90px);
    opacity: 0;
  }

  .titles-nav.is-leaving a:nth-child(1) { transition-delay: 0ms; }
  .titles-nav.is-leaving a:nth-child(2) { transition-delay: 30ms; }
  .titles-nav.is-leaving a:nth-child(3) { transition-delay: 60ms; }
  .titles-nav.is-leaving a:nth-child(4) { transition-delay: 90ms; }
  .titles-nav.is-leaving a:nth-child(5) { transition-delay: 120ms; }
  .titles-nav.is-leaving a:nth-child(6) { transition-delay: 150ms; }
  .titles-nav.is-leaving a:nth-child(7) { transition-delay: 180ms; }
  .titles-nav.is-leaving a:nth-child(8) { transition-delay: 210ms; }
</style>

<script>
  // Handoff to /works: the project titles slide left while a solid
  // veil fades in; navigation happens only once the veil fully covers the
  // page, so the load gap reads as a continuous transition instead of a
  // flash of the bare home page. The works index overlay then takes over
  // with the same titles (see works.astro).
  const titlesNav = document.querySelector('.titles-nav');
  const veil = document.querySelector('.handoff-veil');
  const homeStage = document.querySelector('.home-stage');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const withHandoff = (href: string) => {
    const [path, hash] = href.split('#');
    return `${path}?from=home${hash ? `#${hash}` : ''}`;
  };

  document.querySelectorAll<HTMLAnchorElement>('a[href^="/works"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (reduceMotion || !titlesNav) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      titlesNav.classList.add('is-leaving');
      homeStage?.classList.add('is-fading');
      veil?.classList.add('on');
      const href = link.getAttribute('href') ?? '/works';
      setTimeout(() => { window.location.href = withHandoff(href); }, 460);
    });
  });

  // Back/forward cache: if the user returns via browser Back, the page is
  // restored mid-handoff (veil up, hero faded, titles gone) — reset it.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      titlesNav?.classList.remove('is-leaving');
      homeStage?.classList.remove('is-fading');
      veil?.classList.remove('on');
    }
  });
</script>
