---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getWorks } from '../data/works';
import { HERO_WIDTH, optimizedVariantUrl } from '../lib/image-assets.mjs';

const works = getWorks();
const heroImage = optimizedVariantUrl('/images/HOME.jpg', HERO_WIDTH);
---

<BaseLayout
  title="Home"
  description="P.H. — Photography and travel projects."
>
  <!-- Fixed transparent nav — exact match to lin-zhaoye-photography.html -->
  <header class="topnav-fixed" data-od-id="topnav">
    <div class="topnav-fixed-inner">
      <nav aria-label="Primary navigation">
        <a href="/" class="nav-home" aria-current="page">HOME</a>
        <a href="/works?index" class="nav-work">WORK</a>
        <a href="/about" class="nav-about">ABOUT</a>
      </nav>
    </div>
  </header>

  <main id="content">
    <!-- ── Hero ── -->
    <section class="container home-stage" data-od-id="home-hero" style={`background-color: var(--bg); background-image: var(--hero-overlay), url('${heroImage}'); background-size: auto, cover; background-position: center, center; background-repeat: no-repeat, no-repeat;`}>
      <div class="hero-core">
        <h1 class="sr-only">Photography projects</h1>
        <nav aria-label="Portfolio titles" class="titles-nav">
          {works.map((w, i) => (
            <a href={`/works/${i}`} data-entry-image={w.descriptionCn || w.descriptionEng ? undefined : w.photos[0]?.src}>{w.title}</a>
          ))}
        </nav>
      </div>
    </section>
  </main>

  <Footer pageLabel="Photography" tagline="P.H. — rooms, thresholds, peripheral light" />

</BaseLayout>

<style>
  /* ── Fixed transparent nav ── */
  .topnav-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background: transparent;
    background-image: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
  }

  .topnav-fixed-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 68px;
    padding-inline: var(--gutter);
  }

  .topnav-fixed nav {
    display: flex;
    position: fixed;
    top: 0;
    /* leave room for the fixed theme-toggle icon at the far right */
    right: calc(var(--gutter) + 56px);
    z-index: 21;
    height: 68px;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .topnav-fixed nav a {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .topnav-fixed nav a[aria-current="page"],
  .topnav-fixed nav a:hover {
    color: var(--fg);
  }

  /* ── Home stage hero ── */
  .home-stage {
    min-height: 100svh;
    padding-top: calc(68px + clamp(34px, 5vw, 82px));
    padding-bottom: clamp(34px, 5vw, 82px);
    background-attachment: scroll, fixed;
    /* Fade in on arrival; page changes use the shared view transition. */
    animation: hero-in 0.6s ease backwards;
  }

  @keyframes hero-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-stage {
      animation: none;
    }
  }

  .titles-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(16px, 2vw, 26px);
    width: min(70vw, 860px);
    max-width: 100%;
    padding-top: 4px;
  }

  .titles-nav a {
    display: block;
    width: fit-content;
    max-width: calc(100% - var(--title-offset));
    margin-inline-start: var(--title-offset);
    font-family: var(--font-mono);
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    line-height: 1.35;
    text-align: left;
    text-wrap: balance;
    text-decoration: none;
    text-shadow: 0 1px 8px color-mix(in oklch, var(--bg) 55%, transparent);
  }

  .titles-nav a:nth-child(7n + 1) { --title-offset: 0%; }
  .titles-nav a:nth-child(7n + 2) { --title-offset: 15%; }
  .titles-nav a:nth-child(7n + 3) { --title-offset: 4%; }
  .titles-nav a:nth-child(7n + 4) { --title-offset: 32%; }
  .titles-nav a:nth-child(7n + 5) { --title-offset: 12%; }
  .titles-nav a:nth-child(7n + 6) { --title-offset: 24%; }
  .titles-nav a:nth-child(7n + 7) { --title-offset: 2%; }

  .titles-nav a:hover,
  .titles-nav a:focus-visible {
    color: var(--muted);
  }

  .titles-nav a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 6px;
  }

  .hero-core {
    /* Approved at 1920 × 934: move the list right 287px and down 67px. */
    padding-inline-start: clamp(0px, 14.9479167vw, 287px);
    padding-top: clamp(0px, 7.1734476svh, 67px);
    min-width: 0;
  }

  /* ── Responsive: 620px ── */
  @media (max-width: 620px) {
    :root {
      --gutter: 20px;
    }

    .titles-nav {
      width: 100%;
      gap: 20px;
    }

    .titles-nav a {
      letter-spacing: 0.04em;
    }
    .hero-core {
      padding-inline-start: 0;
    }


    .home-stage {
      background-attachment: scroll;
    }
  }

  .titles-nav a {
    transition: color 0.15s ease;
  }
</style>

<script>
  import { waitForImage } from '../lib/image-crossfade.mjs';

  const preparedImages = new Map<string, Promise<void>>();
  let navigationRequest = 0;
  const prepareImage = (src: string) => {
    let ready = preparedImages.get(src);
    if (!ready) {
      const image = new Image();
      image.src = src;
      // A failed preload must not prevent following the link.
      ready = waitForImage(image).catch(() => {});
      preparedImages.set(src, ready);
    }
    return ready;
  };

  document.querySelectorAll<HTMLAnchorElement>('.titles-nav a').forEach(link => {
    const src = link.dataset.entryImage;
    if (src) {
      link.addEventListener('pointerenter', () => { prepareImage(src); });
      link.addEventListener('focus', () => { prepareImage(src); });
    }
    link.addEventListener('click', async event => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const request = ++navigationRequest;
      if (!src) return;
      event.preventDefault();
      link.setAttribute('aria-busy', 'true');
      await prepareImage(src);
      link.removeAttribute('aria-busy');
      if (request === navigationRequest) window.location.assign(link.href);
    });
  });
</script>
