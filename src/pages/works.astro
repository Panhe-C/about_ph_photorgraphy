---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getWorks } from '../data/works';

const works = getWorks().map((w) => {
  const year = w.folder.match(/\d{4}/)?.[0] ?? w.year;
  return {
    ...w,
    year,
    shortTitle: w.title.replace(/\s*\d{4}\s*$/, ''),
  };
});

const totalPlates = works.reduce((n, w) => n + w.photos.length, 0);

const clientWorks = works.map((w) => ({
  title: w.shortTitle,
  photos: w.photos.map((p) => ({ src: p.src, thumb: p.thumb })),
}));
---

<BaseLayout
  title="Works"
  description="Photography / selected plates by P.H. — interiors, thresholds, late light."
>
  <!-- Fixed transparent nav -->
  <header class="topnav-fixed" data-od-id="topnav">
    <div class="topnav-fixed-inner">
      <nav aria-label="Primary navigation">
        <a href="/" class="nav-home">HOME</a>
        <a href="/works" class="nav-work" aria-current="page">WORK</a>
        <a href="/about" class="nav-about">ABOUT</a>
      </nav>
    </div>
  </header>

  <main id="content">
    <section class="works-room" data-od-id="works-room">
      <!-- Stage: one plate, page-centered, toggle right below it -->
      <div class="stage">
        <div class="plate-box">
          <img
            id="plateImg"
            src={works[0]?.photos[0]?.src}
            alt={`${works[0]?.shortTitle} — plate 1`}
          />
          <button class="step prev" id="stepPrev" type="button" aria-label="Previous plate"></button>
          <button class="step next" id="stepNext" type="button" aria-label="Next plate"></button>
        </div>
        <div class="room-toggle">
          <button class="toggle-btn" id="indexToggle" type="button" aria-expanded="false" aria-controls="indexOverlay">Index</button>
          <span class="toggle-sep" aria-hidden="true"></span>
          <button class="toggle-btn" id="thumbsToggle" type="button" aria-expanded="false" aria-controls="thumbsOverlay">Thumbs</button>
        </div>
      </div>

      <!-- Index overlay: bare series titles -->
      <div class="room-overlay" id="indexOverlay" aria-hidden="true">
        <ul class="series-list">
          {works.map((w, i) => (
            <li>
              <button
                class="series-row"
                type="button"
                data-series={String(i)}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {w.shortTitle}
              </button>
            </li>
          ))}
        </ul>
        <button class="overlay-close" id="indexClose" type="button" aria-label="Close index">&times;</button>
      </div>

      <script is:inline>
        // Runs synchronously during parse, before first paint: when arriving
        // from home, the index overlay must be fully open in the very first
        // frame — the page module runs too late (post-paint), which is what
        // let a bare works page flash through mid-handoff.
        if (new URLSearchParams(location.search).get('from') === 'home') {
          var ovl = document.getElementById('indexOverlay');
          ovl.classList.add('open', 'is-instant');
          ovl.setAttribute('aria-hidden', 'false');
          document.getElementById('indexToggle').setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            ovl.classList.add('is-entering');
          }
        }
      </script>

      <!-- Thumbs overlay: every plate, grouped by series -->
      <div class="room-overlay thumbs-overlay" id="thumbsOverlay" aria-hidden="true">
        <div class="thumbs-scroll">
          {works.map((w, i) => (
            <section class="thumbs-series">
              <p class="thumbs-series-title meta">{w.shortTitle}</p>
              <div class="thumbs-grid">
                {w.photos.map((p, pi) => (
                  <button
                    class="thumb-cell"
                    type="button"
                    data-series={String(i)}
                    data-photo={String(pi)}
                    aria-label={`${w.shortTitle} — plate ${pi + 1}`}
                  >
                    <img src={p.thumb} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>
        <button class="overlay-close" id="thumbsClose" type="button" aria-label="Close thumbnails">&times;</button>
      </div>

      <!-- Screensaver: kicks in after idle, any input exits -->
      <div class="screensaver" id="screensaver" aria-hidden="true">
        <img id="ssImg" alt="" />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script type="application/json" id="worksData" set:html={JSON.stringify(clientWorks)}></script>

<script>
  const works = JSON.parse(document.getElementById('worksData')!.textContent!);

  const plateImg = document.getElementById('plateImg') as HTMLImageElement;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.series-row'));
  const indexToggle = document.getElementById('indexToggle')!;
  const thumbsToggle = document.getElementById('thumbsToggle')!;
  const indexOverlay = document.getElementById('indexOverlay')!;
  const thumbsOverlay = document.getElementById('thumbsOverlay')!;
  const overlays = [indexOverlay, thumbsOverlay];
  const toggles = [indexToggle, thumbsToggle];

  let currentSeries = 0;
  let currentPhoto = 0;

  function render() {
    const w = works[currentSeries];
    plateImg.style.opacity = '0';
    plateImg.onload = () => { plateImg.style.opacity = '1'; };
    plateImg.src = w.photos[currentPhoto].src;
    plateImg.alt = `${w.title} — plate ${currentPhoto + 1}`;
    rows.forEach((r, j) => r.setAttribute('aria-pressed', String(j === currentSeries)));
  }

  function goTo(series: number, photo: number) {
    currentSeries = series;
    currentPhoto = photo;
    render();
    history.replaceState(null, '', `#${series}`);
  }

  function stepPhoto(dir: number) {
    const len = works[currentSeries].photos.length;
    goTo(currentSeries, (currentPhoto + dir + len) % len);
  }

  function stepSeries(dir: number) {
    goTo((currentSeries + dir + works.length) % works.length, 0);
  }

  /* ── Overlays (Index / Thumbs) ── */
  function openOverlay(el: HTMLElement, btn: HTMLElement) {
    overlays.forEach((o) => { o.classList.remove('open'); o.setAttribute('aria-hidden', 'true'); });
    toggles.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    el.classList.add('open');
    el.setAttribute('aria-hidden', 'false');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeOverlays() {
    overlays.forEach((o) => { o.classList.remove('open'); o.setAttribute('aria-hidden', 'true'); });
    toggles.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    document.body.style.overflow = '';
  }
  const anyOverlayOpen = () => overlays.some((o) => o.classList.contains('open'));

  indexToggle.addEventListener('click', () => {
    indexOverlay.classList.contains('open') ? closeOverlays() : openOverlay(indexOverlay, indexToggle);
  });
  thumbsToggle.addEventListener('click', () => {
    thumbsOverlay.classList.contains('open') ? closeOverlays() : openOverlay(thumbsOverlay, thumbsToggle);
  });
  document.getElementById('indexClose')!.addEventListener('click', closeOverlays);
  document.getElementById('thumbsClose')!.addEventListener('click', closeOverlays);
  overlays.forEach((o) => o.addEventListener('click', (e) => { if (e.target === o) closeOverlays(); }));

  rows.forEach((row, i) => {
    row.addEventListener('click', () => { goTo(i, 0); closeOverlays(); });
  });
  document.querySelectorAll<HTMLElement>('.thumb-cell').forEach((cell) => {
    cell.addEventListener('click', () => {
      goTo(Number(cell.dataset.series), Number(cell.dataset.photo));
      closeOverlays();
    });
  });
  document.getElementById('stepPrev')!.addEventListener('click', () => stepPhoto(-1));
  document.getElementById('stepNext')!.addEventListener('click', () => stepPhoto(1));

  /* ── Screensaver: starts after idle, any input exits ── */
  const IDLE_MS = 40_000;
  const SLIDE_MS = 3_200;
  const allPhotos = works.flatMap((w, si) =>
    w.photos.map((p: { src: string; thumb: string }, pi: number) => ({ src: p.src, si, pi }))
  );
  const ssEl = document.getElementById('screensaver')!;
  const ssImg = document.getElementById('ssImg') as HTMLImageElement;
  let ssActive = false;
  let ssJustExited = false;
  let ssIndex = 0;
  let idleTimer = 0;
  let slideTimer = 0;

  function ssAdvance() {
    ssIndex = (ssIndex + 1) % allPhotos.length;
    ssImg.style.opacity = '0';
    setTimeout(() => { ssImg.src = allPhotos[ssIndex].src; }, 500);
  }
  ssImg.onload = () => { if (ssActive) ssImg.style.opacity = '1'; };

  function startScreensaver() {
    ssActive = true;
    ssIndex = allPhotos.findIndex((p) => p.si === currentSeries && p.pi === currentPhoto);
    ssImg.src = allPhotos[ssIndex].src;
    ssEl.classList.add('on');
    ssEl.setAttribute('aria-hidden', 'false');
    slideTimer = window.setInterval(ssAdvance, SLIDE_MS);
  }
  function exitScreensaver() {
    ssActive = false;
    ssJustExited = true;
    setTimeout(() => { ssJustExited = false; }, 50);
    ssEl.classList.remove('on');
    ssEl.setAttribute('aria-hidden', 'true');
    clearInterval(slideTimer);
    ssImg.style.opacity = '0';
  }
  function resetIdle() {
    clearTimeout(idleTimer);
    idleTimer = window.setTimeout(startScreensaver, IDLE_MS);
  }

  (['mousemove', 'mousedown', 'keydown', 'wheel', 'touchstart'] as const).forEach((ev) => {
    window.addEventListener(ev, (e) => {
      if (ssActive) {
        e.stopPropagation();
        e.preventDefault();
        exitScreensaver();
      }
      resetIdle();
    }, { capture: true });
  });
  // Swallow the click that dismissed the screensaver so it doesn't advance a plate
  window.addEventListener('click', (e) => {
    if (ssJustExited) {
      e.stopPropagation();
      e.preventDefault();
    }
  }, { capture: true });
  resetIdle();

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (e.key === 'Escape' && anyOverlayOpen()) { closeOverlays(); return; }
    if (anyOverlayOpen()) return;
    if (e.key === 'ArrowRight') { e.preventDefault(); stepPhoto(1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); stepPhoto(-1); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); stepSeries(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); stepSeries(-1); }
  });

  // Deep link (e.g. from the home page index)
  const hashIndex = parseInt(location.hash.slice(1), 10);
  if (hashIndex >= 0 && hashIndex < works.length) {
    goTo(hashIndex, 0);
  }

  // Arriving from home: the inline script already opened the overlay
  // pre-paint; here we only strip the param and clean up the one-shot
  // transition classes after the rows have slid in.
  if (new URLSearchParams(location.search).get('from') === 'home') {
    setTimeout(() => indexOverlay.classList.remove('is-entering', 'is-instant'), 1000);
    history.replaceState(null, '', `${location.pathname}${location.hash}`);
  }
</script>

<style>
  .topnav-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
  }

  .topnav-fixed-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 68px;
    padding-inline: var(--gutter);
  }

  .topnav-fixed nav {
    display: flex;
    position: fixed;
    top: 0;
    right: clamp(240px, 20vw, 420px);
    z-index: 21;
    height: 68px;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .topnav-fixed nav a {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .topnav-fixed nav a[aria-current='page'],
  .topnav-fixed nav a:hover {
    color: var(--fg);
  }

  /* ── Viewing room: exactly one viewport, no page scroll ── */
  .works-room {
    height: 100svh;
    overflow: hidden;
    padding-top: 68px;
  }

  .stage {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.5svh, 26px);
    /* clear the fixed footer */
    padding-bottom: 88px;
  }

  .plate-box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* JD proportion: roughly 45vw × 58svh, dead center, wide empty canvas */
  .stage img {
    max-width: 45vw;
    max-height: 58svh;
    object-fit: contain;
    transition: opacity 0.18s ease;
  }

  .step {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    cursor: w-resize;
  }

  .step.prev { left: 0; }
  .step.next { right: 0; cursor: e-resize; }

  .room-toggle {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .toggle-btn {
    padding: 4px 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .toggle-btn:hover,
  .toggle-btn[aria-expanded='true'] {
    color: var(--fg);
  }

  .toggle-sep {
    width: 22px;
    height: 1px;
    background: var(--muted);
    opacity: 0.5;
  }

  /* ── Overlays (Index / Thumbs) ── */
  .room-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: color-mix(in oklch, var(--bg) 96%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .room-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Instant open for the home→works handoff (no fade on first paint) */
  .room-overlay.is-instant {
    transition: none;
  }

  .series-list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
  }

  .series-row {
    width: 100%;
    padding: 10px 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .series-row:hover,
  .series-row[aria-pressed='true'] {
    color: var(--fg);
  }

  /* Entry handoff from home: rows slide in from the right */
  #indexOverlay.is-entering .series-row {
    animation: row-in 0.38s cubic-bezier(0.22, 0.8, 0.36, 1) both;
  }

  #indexOverlay.is-entering li:nth-child(1) .series-row { animation-delay: 45ms; }
  #indexOverlay.is-entering li:nth-child(2) .series-row { animation-delay: 90ms; }
  #indexOverlay.is-entering li:nth-child(3) .series-row { animation-delay: 135ms; }
  #indexOverlay.is-entering li:nth-child(4) .series-row { animation-delay: 180ms; }
  #indexOverlay.is-entering li:nth-child(5) .series-row { animation-delay: 225ms; }
  #indexOverlay.is-entering li:nth-child(6) .series-row { animation-delay: 270ms; }
  #indexOverlay.is-entering li:nth-child(7) .series-row { animation-delay: 315ms; }
  #indexOverlay.is-entering li:nth-child(8) .series-row { animation-delay: 360ms; }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .overlay-close {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 22px;
    line-height: 1;
    padding: 8px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .overlay-close:hover { color: var(--fg); }

  /* ── Thumbs overlay ── */
  .thumbs-overlay { align-items: stretch; justify-content: stretch; }

  .thumbs-scroll {
    width: 100%;
    overflow-y: auto;
    padding: calc(68px + 34px) var(--gutter) 96px;
  }

  .thumbs-series-title {
    margin: 34px 0 14px;
    color: var(--muted);
  }

  .thumbs-series:first-child .thumbs-series-title { margin-top: 0; }

  .thumbs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }

  .thumb-cell {
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.15s ease;
    padding: 0;
  }

  .thumb-cell:hover { opacity: 1; }

  .thumb-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Screensaver ── */
  .screensaver {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .screensaver.on {
    opacity: 1;
    pointer-events: auto;
    cursor: none;
  }

  .screensaver img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage img { transition: none; }
    .screensaver,
    .screensaver img { transition: none; }
  }

  @media (max-width: 980px) {
    .topnav-fixed nav {
      position: static;
      height: auto;
      flex-wrap: wrap;
    }

    .topnav-fixed nav a { height: auto; }

    .stage img {
      max-width: 86vw;
      max-height: 54svh;
    }

    .thumbs-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
  }

  @media (max-width: 620px) {
    :root { --gutter: 20px; }
  }

  /* Bare fixed footer on this page — copyright bottom-right, no rule */
  :global(.pagefoot) {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    border-top: none;
  }

  :global(.pagefoot .foot-grid) {
    grid-template-columns: 1fr;
  }

  :global(.pagefoot .foot-grid > span) {
    justify-self: end;
  }
</style>
