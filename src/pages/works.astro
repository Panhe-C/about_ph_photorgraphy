---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getWorks } from '../data/works';

const works = getWorks().map((w) => {
  const year = w.folder.match(/\d{4}/)?.[0] ?? w.year;
  return {
    ...w,
    year,
    shortTitle: w.title.replace(/\s*\d{4}\s*$/, ''),
  };
});

const totalPlates = works.reduce((n, w) => n + w.photos.length, 0);

const clientWorks = works.map((w) => ({
  title: w.shortTitle,
  fullTitle: w.title,
  descriptionCn: w.descriptionCn,
  descriptionEng: w.descriptionEng,
  hasDesc: Boolean(w.descriptionCn || w.descriptionEng),
  photos: w.photos.map((p) => ({ src: p.src, thumb: p.thumb, caption: p.caption })),
}));

interface Props {
  initialSeries?: number;
}
const requestedSeries = Astro.props.initialSeries ?? 0;
const initialSeries = Number.isInteger(requestedSeries) && requestedSeries >= 0 && requestedSeries < works.length ? requestedSeries : 0;
const initialWork = works[initialSeries];
const firstHasDesc = Boolean(initialWork?.descriptionCn || initialWork?.descriptionEng);
const firstCaption = firstHasDesc ? '' : initialWork?.photos[0]?.caption || `${initialWork?.title ?? ''} — 01`;
---

<BaseLayout
  title="Works"
  description="Photography / selected plates by P.H. — interiors, thresholds, late light."
>
  <!-- Fixed transparent nav -->
  <header class="topnav-fixed" data-od-id="topnav">
    <div class="topnav-fixed-inner">
      <nav aria-label="Primary navigation">
        <a href="/" class="nav-home">HOME</a>
        <a href="/works" class="nav-work" aria-current="page">WORK</a>
      </nav>
    </div>
  </header>

  <main id="content">
    <section class="works-room" data-od-id="works-room">
      <!-- Stage: one plate, page-centered, toggle right below it -->
      <div class="stage" class:list={[{ 'show-desc': firstHasDesc }]} data-initial-series={initialSeries}>
        <div class="plate-box">
          <div class="plate-layer is-active" data-plate-layer aria-hidden={String(firstHasDesc)}>
            <div class="plate-unit">
              <img
                src={initialWork?.photos[0]?.src}
                alt={`${initialWork?.shortTitle} — plate 1`}
                fetchpriority={firstHasDesc ? 'auto' : 'high'}
              />
              <p class="plate-caption">{firstCaption}</p>
            </div>
          </div>
          <div class="plate-layer" data-plate-layer aria-hidden="true">
            <div class="plate-unit">
              <img src="" alt="" />
              <p class="plate-caption"></p>
            </div>
          </div>
          <p id="plateAnnouncement" class="sr-only" aria-live="polite" aria-atomic="true">{firstHasDesc ? '' : firstCaption}</p>
          <button class="step prev" id="stepPrev" type="button" aria-label="Previous plate"></button>
          <button class="step next" id="stepNext" type="button" aria-label="Next plate"></button>
        </div>
        <div class="room-toggle">
          <button
            class="toggle-btn"
            id="modeToggle"
            type="button"
            aria-expanded="false"
            aria-controls="indexOverlay thumbsOverlay"
          >Index</button>
        </div>

        <!-- Series description: CN left of the plate, ENG right -->
        <aside
          class="plate-desc plate-desc-cn"
          class:list={[{ 'is-empty': !initialWork?.descriptionCn }]}
          id="plateDescCn"
          aria-live="polite"
        >
          <p class="desc-cn" id="descCn">{initialWork?.descriptionCn}</p>
        </aside>
        <aside
          class="plate-desc plate-desc-eng"
          class:list={[{ 'is-empty': !initialWork?.descriptionEng }]}
          id="plateDescEng"
          aria-live="polite"
        >
          <p class="desc-eng" id="descEng">{initialWork?.descriptionEng}</p>
        </aside>
      </div>

      <!-- Index overlay: bare series titles -->
      <div class="room-overlay" id="indexOverlay" aria-hidden="true">
        <ul class="series-list">
          {works.map((w, i) => (
            <li>
              <button
                class="series-row"
                type="button"
                data-series={String(i)}
                aria-pressed={i === initialSeries ? 'true' : 'false'}
              >
                {w.shortTitle}
              </button>
            </li>
          ))}
        </ul>
        <button class="overlay-close" id="indexClose" type="button" aria-label="Close index">&times;</button>
      </div>

      <script is:inline>
        // Runs synchronously during parse, before first paint: when arriving
        // from home, the index overlay must be fully open in the very first
        // frame — the page module runs too late (post-paint), which is what
        // let a bare works page flash through mid-handoff.
        if (new URLSearchParams(location.search).get('from') === 'home'
            || new URLSearchParams(location.search).has('index')) {
          var ovl = document.getElementById('indexOverlay');
          ovl.classList.add('open', 'is-instant');
          ovl.setAttribute('aria-hidden', 'false');
          document.getElementById('modeToggle').setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            ovl.classList.add('is-entering');
          }
        }
      </script>

      <!-- Thumbs overlay: every plate, grouped by series -->
      <div class="room-overlay thumbs-overlay" id="thumbsOverlay" aria-hidden="true">
        <div class="thumbs-scroll">
          {works.map((w, i) => (
            <section class="thumbs-series">
              <p class="thumbs-series-title meta">{w.shortTitle}</p>
              <div class="thumbs-grid">
                {w.photos.map((p, pi) => (
                  <button
                    class="thumb-cell"
                    type="button"
                    data-series={String(i)}
                    data-photo={String(pi)}
                    aria-label={`${w.shortTitle} — plate ${pi + 1}`}
                  >
                    <img src={p.thumb} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>
        <button class="overlay-close" id="thumbsClose" type="button" aria-label="Close thumbnails">&times;</button>
      </div>

      <!-- Screensaver: kicks in after idle, any input exits -->
      <div class="screensaver" id="screensaver" aria-hidden="true">
        <img id="ssImg" alt="" />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script type="application/json" id="worksData" set:html={JSON.stringify(clientWorks)}></script>

<script>
  import {
    createAnnouncementState,
    createLatestCrossfade,
    crossfadeLayers,
    waitForImage,
  } from '../lib/image-crossfade.mjs';

  const works = JSON.parse(document.getElementById('worksData')!.textContent!);

  const stage = document.querySelector('.stage')!;
  const plateLayers = Array.from(
    document.querySelectorAll<HTMLElement>('[data-plate-layer]'),
  );
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const plateDescCn = document.getElementById('plateDescCn')!;
  const plateDescEng = document.getElementById('plateDescEng')!;
  const descCn = document.getElementById('descCn')!;
  const descEng = document.getElementById('descEng')!;
  const plateAnnouncement = document.getElementById('plateAnnouncement')!;
  const captionAnnouncement = createAnnouncementState(plateAnnouncement.textContent ?? '');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.series-row'));
  const modeToggle = document.getElementById('modeToggle')!;
  const indexOverlay = document.getElementById('indexOverlay')!;
  const thumbsOverlay = document.getElementById('thumbsOverlay')!;
  const overlays = [indexOverlay, thumbsOverlay];

  let currentSeries = Number(stage.getAttribute('data-initial-series')) || 0;
  // -1 = the series' description plate (shown first when _description files exist)
  let currentPhoto = works[currentSeries]?.hasDesc ? -1 : 0;
  let activeLayerIndex = 0;

  function clearPlateOpacity() {
    plateLayers.forEach((layer) => { layer.style.opacity = ''; });
  }

  function previewCaptionAnnouncement(caption: string) {
    plateAnnouncement.textContent = captionAnnouncement.preview(caption);
  }

  function commitCaptionAnnouncement(caption: string) {
    plateAnnouncement.textContent = captionAnnouncement.commit(caption);
  }

  function rollbackCaptionAnnouncement() {
    plateAnnouncement.textContent = captionAnnouncement.rollback();
  }

  function restoreActiveLayerAccessibility() {
    plateLayers.forEach((layer, index) => {
      layer.setAttribute('aria-hidden', String(index !== activeLayerIndex));
    });
  }

  function activateIncomingLayer(incomingIndex: number) {
    const outgoing = plateLayers[activeLayerIndex];
    const incoming = plateLayers[incomingIndex];
    outgoing.setAttribute('aria-hidden', 'true');
    incoming.setAttribute('aria-hidden', 'false');
    outgoing.classList.remove('is-active');
    incoming.classList.add('is-active');
    activeLayerIndex = incomingIndex;
    clearPlateOpacity();
  }

  function plateTarget() {
    const work = works[currentSeries];
    const photo = work.photos[currentPhoto];
    return {
      series: currentSeries,
      photo: currentPhoto,
      src: photo.src,
      alt: `${work.title} — plate ${currentPhoto + 1}`,
      caption:
        photo.caption ||
        `${work.fullTitle} — ${String(currentPhoto + 1).padStart(2, '0')}`,
    };
  }

  const plateCrossfade = createLatestCrossfade({
    async prepare(target, signal) {
      const incomingIndex = 1 - activeLayerIndex;
      const layer = plateLayers[incomingIndex];
      const image = layer.querySelector('img') as HTMLImageElement;
      const caption = layer.querySelector('.plate-caption')!;
      layer.style.opacity = '0';
      image.src = target.src;
      image.alt = target.alt;
      caption.textContent = target.caption;
      await waitForImage(image, signal);
      return { incomingIndex };
    },
    async transition({ incomingIndex }, target, signal) {
      const outgoing = plateLayers[activeLayerIndex];
      const incoming = plateLayers[incomingIndex];
      const leavingDescription = stage.classList.contains('show-desc');

      if (leavingDescription) {
        activateIncomingLayer(incomingIndex);
        stage.classList.remove('show-desc');
        commitCaptionAnnouncement(target.caption);
        return true;
      }

      const completed = await crossfadeLayers({
        outgoing,
        incoming,
        duration: 220,
        reducedMotion: reducedMotion.matches,
        signal,
        onStart() {
          outgoing.setAttribute('aria-hidden', 'true');
          incoming.setAttribute('aria-hidden', 'false');
          previewCaptionAnnouncement(target.caption);
        },
        onAbort() {
          restoreActiveLayerAccessibility();
          rollbackCaptionAnnouncement();
        },
      });
      if (completed) {
        activateIncomingLayer(incomingIndex);
        commitCaptionAnnouncement(target.caption);
      }
      return completed;
    },
    onError(error) {
      clearPlateOpacity();
      rollbackCaptionAnnouncement();
      console.error(error);
    },
  });

  function render() {
    const w = works[currentSeries];
    const showingDesc = currentPhoto < 0;
    descCn.textContent = w.descriptionCn;
    descEng.textContent = w.descriptionEng;
    plateDescCn.classList.toggle('is-empty', !w.descriptionCn);
    plateDescEng.classList.toggle('is-empty', !w.descriptionEng);
    if (showingDesc) {
      plateCrossfade.cancel();
      stage.classList.add('show-desc');
      plateLayers.forEach((layer) => layer.setAttribute('aria-hidden', 'true'));
      clearPlateOpacity();
      commitCaptionAnnouncement('');
    } else {
      plateCrossfade.request(plateTarget());
    }
    rows.forEach((r, j) => r.setAttribute('aria-pressed', String(j === currentSeries)));
  }

  function goTo(series: number, photo: number) {
    currentSeries = series;
    currentPhoto = photo;
    render();
    history.replaceState(null, '', `/works/${series}`);
  }

  // Photo cycle per series: optional description plate, then plates 1..n
  function stepPhoto(dir: number) {
    const w = works[currentSeries];
    const start = w.hasDesc ? -1 : 0;
    const total = w.photos.length + (w.hasDesc ? 1 : 0);
    const idx = (currentPhoto - start + dir + total) % total;
    goTo(currentSeries, idx + start);
  }

  function stepSeries(dir: number) {
    const next = (currentSeries + dir + works.length) % works.length;
    goTo(next, works[next].hasDesc ? -1 : 0);
  }

  /* ── Overlays: one button switching Index ⇄ Thumbs; closing happens
     via the overlay's × button, ESC, or clicking the backdrop ── */
  function syncToggle() {
    const indexOpen = indexOverlay.classList.contains('open');
    const thumbsOpen = thumbsOverlay.classList.contains('open');
    modeToggle.textContent = indexOpen ? 'Thumbs' : 'Index';
    modeToggle.setAttribute('aria-expanded', String(indexOpen || thumbsOpen));
    // the button floats above overlays; over the scrolling thumbs grid it
    // overlaps the images, so hide it there (close via ×, ESC, or backdrop)
    modeToggle.classList.toggle('is-hidden', thumbsOpen);
  }

  function openOverlay(el: HTMLElement) {
    overlays.forEach((o) => { o.classList.remove('open'); o.setAttribute('aria-hidden', 'true'); });
    el.classList.add('open');
    el.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    syncToggle();
  }
  function closeOverlays() {
    overlays.forEach((o) => { o.classList.remove('open'); o.setAttribute('aria-hidden', 'true'); });
    document.body.style.overflow = '';
    syncToggle();
  }
  const anyOverlayOpen = () => overlays.some((o) => o.classList.contains('open'));

  modeToggle.addEventListener('click', () => {
    openOverlay(indexOverlay.classList.contains('open') ? thumbsOverlay : indexOverlay);
  });

  // Clicking WORK while already on /works: reopen the series index instead
  // of reloading the page into the first series' description plate
  document.querySelector('.nav-work')!.addEventListener('click', (e) => {
    e.preventDefault();
    openOverlay(indexOverlay);
  });
  document.getElementById('indexClose')!.addEventListener('click', closeOverlays);
  document.getElementById('thumbsClose')!.addEventListener('click', closeOverlays);
  overlays.forEach((o) => o.addEventListener('click', (e) => { if (e.target === o) closeOverlays(); }));

  rows.forEach((row, i) => {
    row.addEventListener('click', () => { goTo(i, works[i].hasDesc ? -1 : 0); closeOverlays(); });
  });
  document.querySelectorAll<HTMLElement>('.thumb-cell').forEach((cell) => {
    cell.addEventListener('click', () => {
      goTo(Number(cell.dataset.series), Number(cell.dataset.photo));
      closeOverlays();
    });
  });
  document.getElementById('stepPrev')!.addEventListener('click', () => stepPhoto(-1));
  document.getElementById('stepNext')!.addEventListener('click', () => stepPhoto(1));

  /* ── Screensaver: starts after idle, any input exits ── */
  const IDLE_MS = 40_000;
  const SLIDE_MS = 3_200;
  const allPhotos = works.flatMap((w, si) =>
    w.photos.map((p: { src: string; thumb: string }, pi: number) => ({ src: p.src, si, pi }))
  );
  const ssEl = document.getElementById('screensaver')!;
  const ssImg = document.getElementById('ssImg') as HTMLImageElement;
  let ssActive = false;
  let ssJustExited = false;
  let ssIndex = 0;
  let idleTimer = 0;
  let slideTimer = 0;

  function ssAdvance() {
    ssIndex = (ssIndex + 1) % allPhotos.length;
    ssImg.style.opacity = '0';
    setTimeout(() => { ssImg.src = allPhotos[ssIndex].src; }, 500);
  }
  ssImg.onload = () => { if (ssActive) ssImg.style.opacity = '1'; };

  function startScreensaver() {
    ssActive = true;
    ssIndex = allPhotos.findIndex((p) => p.si === currentSeries && p.pi === currentPhoto);
    if (ssIndex < 0) ssIndex = allPhotos.findIndex((p) => p.si === currentSeries);
    if (ssIndex < 0) ssIndex = 0;
    ssImg.src = allPhotos[ssIndex].src;
    ssEl.classList.add('on');
    ssEl.setAttribute('aria-hidden', 'false');
    slideTimer = window.setInterval(ssAdvance, SLIDE_MS);
  }
  function exitScreensaver() {
    ssActive = false;
    ssJustExited = true;
    setTimeout(() => { ssJustExited = false; }, 50);
    ssEl.classList.remove('on');
    ssEl.setAttribute('aria-hidden', 'true');
    clearInterval(slideTimer);
    ssImg.style.opacity = '0';
  }
  function resetIdle() {
    clearTimeout(idleTimer);
    idleTimer = window.setTimeout(startScreensaver, IDLE_MS);
  }

  (['mousemove', 'mousedown', 'keydown', 'wheel', 'touchstart'] as const).forEach((ev) => {
    window.addEventListener(ev, (e) => {
      if (ssActive) {
        e.stopPropagation();
        e.preventDefault();
        exitScreensaver();
      }
      resetIdle();
    }, { capture: true });
  });
  // Swallow the click that dismissed the screensaver so it doesn't advance a plate
  window.addEventListener('click', (e) => {
    if (ssJustExited) {
      e.stopPropagation();
      e.preventDefault();
    }
  }, { capture: true });
  resetIdle();

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (e.key === 'Escape' && anyOverlayOpen()) { closeOverlays(); return; }
    if (anyOverlayOpen()) return;
    if (e.key === 'ArrowRight') { e.preventDefault(); stepPhoto(1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); stepPhoto(-1); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); stepSeries(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); stepSeries(-1); }
  });

  // Deep link (e.g. from the home page index): land on the description
  // plate first when the series has one
  const searchParams = new URLSearchParams(location.search);
  const hashIndex = parseInt(location.hash.slice(1), 10);
  if (hashIndex >= 0 && hashIndex < works.length) {
    goTo(hashIndex, works[hashIndex].hasDesc ? -1 : 0);
  }

  // Arriving from home (or via ?index): the inline script already opened
  // the overlay pre-paint; here we only strip the param and clean up the
  // one-shot transition classes after the rows have slid in.
  if (searchParams.get('from') === 'home' || searchParams.has('index')) {
    setTimeout(() => indexOverlay.classList.remove('is-entering', 'is-instant'), 1000);
    history.replaceState(null, '', `${location.pathname}${location.hash}`);
  }
  syncToggle();
</script>

<style>
  .topnav-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
  }

  .topnav-fixed-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 68px;
    padding-inline: var(--gutter);
  }

  .topnav-fixed nav {
    display: flex;
    position: fixed;
    top: 0;
    /* match the home page nav position (clears the theme-toggle icon) */
    right: calc(var(--gutter) + 56px);
    z-index: 21;
    height: 68px;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .topnav-fixed nav a {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .topnav-fixed nav a[aria-current='page'],
  .topnav-fixed nav a:hover {
    color: var(--fg);
  }

  /* ── Viewing room: exactly one viewport, no page scroll ── */
  .works-room {
    height: 100svh;
    overflow: hidden;
    padding-top: 68px;
  }

  .stage {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.5svh, 26px);
    /* clear the fixed footer */
    padding-bottom: 88px;
  }

  .plate-box {
    position: relative;
    width: 45vw;
    height: 58svh;
  }

  .plate-layer {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  .plate-layer.is-active,
  .plate-layer[aria-hidden='false'] {
    opacity: 1;
  }

  .stage.show-desc .plate-layer {
    opacity: 0 !important;
  }

  .plate-unit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* JD proportion: roughly 45vw × 58svh, dead center, wide empty canvas */
  .plate-unit img {
    display: block;
    max-width: 45vw;
    max-height: 58svh;
    object-fit: contain;
  }

  /* Caption pinned just under the plate, whatever its aspect ratio —
     same typeface as the ENG description on the right */
  .plate-caption {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin: 14px 0 0;
    font-size: 11px;
    line-height: 1.8;
    color: var(--muted);
    white-space: nowrap;
  }

  .step {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    cursor: w-resize;
  }

  .step.prev { left: 0; }
  .step.next { right: 0; cursor: e-resize; }

  .room-toggle {
    display: flex;
    align-items: center;
    /* pinned to the bottom-left corner, on the same baseline as the fixed
       footer's copyright (bottom-right) — padding-block 34px, minus the
       button's own 4px vertical padding */
    position: fixed;
    bottom: 30px;
    left: var(--gutter);
    /* keep it above the overlays (z-index 100) so the Index ⇄ Thumbs
       switch stays reachable while one is open */
    z-index: 150;
  }

  .toggle-btn {
    padding: 4px 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .toggle-btn:hover,
  .toggle-btn[aria-expanded='true'] {
    color: var(--fg);
  }

  .toggle-btn.is-hidden {
    visibility: hidden;
  }

  /* ── Series description: CN left of the plate, ENG right ── */
  .plate-desc {
    position: absolute;
    /* stage center sits below the plate center (footer clearance shifts
       the image up) — offset so the text tracks the image */
    top: calc(50% - 44px);
    transform: translateY(-50%);
    width: min(240px, 20vw);
    text-align: left;
    transition:
      left 0.55s cubic-bezier(0.22, 0.8, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 0.8, 0.36, 1),
      opacity 0.4s ease;
  }

  /* Descriptions only live on the description plate; browsing photos
     fades them out as they drift to the sides */
  .stage:not(.show-desc) .plate-desc {
    opacity: 0;
    pointer-events: none;
  }

  .plate-desc-cn {
    left: var(--gutter);
  }

  .plate-desc-eng {
    left: calc(100% - var(--gutter) - min(240px, 20vw));
  }

  /* Description plate: both blocks meet at the page center, CN above ENG */
  .stage.show-desc .plate-desc-cn {
    left: 50%;
    transform: translate(-50%, calc(-100% - 14px));
  }

  .stage.show-desc .plate-desc-eng {
    left: 50%;
    transform: translate(-50%, 14px);
  }

  .plate-desc.is-empty {
    display: none;
  }

  .desc-cn,
  .desc-eng {
    margin: 0;
    line-height: 1.8;
  }

  .desc-cn {
    font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--fg);
  }

  .desc-eng {
    font-size: 11px;
    color: var(--muted);
  }

  /* ── Overlays (Index / Thumbs) ── */
  .room-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: color-mix(in oklch, var(--bg) 96%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
