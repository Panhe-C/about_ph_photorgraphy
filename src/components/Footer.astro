---
interface Props {
  pageLabel?: string;
  tagline?: string;
}

const { pageLabel, tagline } = Astro.props;
---

<footer class="pagefoot">
  <div class="container foot-grid meta">
    <span>&copy; P.H. / 2026</span>
    {pageLabel && <span>{pageLabel}</span>}
    {tagline && <span>{tagline}</span>}
  </div>
</footer>
