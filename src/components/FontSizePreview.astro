<aside class="font-size-preview" aria-label="项目排版调整" hidden>
  <div class="preview-heading">
    <label for="project-font-size">项目字号</label>
    <output for="project-font-size" id="project-font-size-value"></output>
  </div>
  <input id="project-font-size" type="range" min="10" max="40" step="0.5" />
  <div class="position-controls">
    <label class="drag-toggle"><input type="checkbox" data-position-edit checked />拖动调位置</label>
    <label class="target-label" for="project-position-target">调节对象</label>
    <select id="project-position-target"><option value="all">整个列表</option></select>
    <div class="preview-heading">
      <label for="project-position-x">横向偏移</label>
      <output for="project-position-x" data-position-x-value></output>
    </div>
    <input id="project-position-x" type="range" step="1" value="0" />
    <div class="preview-heading">
      <label for="project-position-y">纵向偏移</label>
      <output for="project-position-y" data-position-y-value></output>
    </div>
    <input id="project-position-y" type="range" step="1" value="0" />
  </div>
  <p>拖动标题调单项，拖动列表空白处调整体。也可选对象后用滑块微调。</p>
  <div class="preview-actions">
    <button type="button" data-font-reset>恢复默认</button>
    <button type="button" data-font-copy>复制全部参数</button>
  </div>
  <span class="preview-status" role="status"></span>
</aside>

<style>
  .font-size-preview[hidden] { display: none; }

  .font-size-preview {
    position: fixed;
    right: var(--gutter);
    bottom: 24px;
    z-index: 35;
    width: min(280px, calc(100vw - 40px));
    padding: 18px;
    border: 1px solid var(--border);
    background: color-mix(in oklch, var(--bg) 92%, transparent);
    color: var(--fg);
    backdrop-filter: blur(12px);
    font-size: 12px;
  }

  .preview-heading, .preview-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  output {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  input {
    display: block;
    width: 100%;
    min-height: 32px;
    margin: 10px 0;
    accent-color: var(--fg);
    cursor: pointer;
  }

  p { color: var(--muted); }
  .position-controls { border-top: 1px solid var(--border); padding-top: 12px; margin-bottom: 10px; }
  .drag-toggle { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .drag-toggle input { width: 14px; min-height: 0; margin: 0; }
  .target-label { display: block; color: var(--muted); margin-bottom: 6px; }
  select { width: 100%; padding: 7px; margin-bottom: 14px; background: var(--bg); color: var(--fg); border: 1px solid var(--border); font: inherit; }
  :global(.titles-nav.is-position-editing) { cursor: grab; touch-action: none; user-select: none; }
  :global(.titles-nav.is-position-editing a) { cursor: grab; }
  :global(.titles-nav.is-position-dragging), :global(.titles-nav.is-position-dragging a) { cursor: grabbing; }
  :global(.titles-nav.is-position-editing .preview-position-target) { outline: 1px dashed var(--muted); outline-offset: 5px; }
  .preview-actions { margin-top: 16px; }

  button {
    padding: 6px 0;
    border-bottom: 1px solid var(--muted);
  }

  button:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 4px;
  }

  .preview-status:empty { display: none; }
  .preview-status { display: block; margin-top: 12px; color: var(--muted); }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('.font-size-preview');
  const titles = document.querySelector<HTMLElement>('.titles-nav');
  const slider = document.querySelector<HTMLInputElement>('#project-font-size');
  const value = document.querySelector<HTMLOutputElement>('#project-font-size-value');

  if (panel && titles && slider && value) {
    const storageKey = 'ph:home:project-font-size';
    const positionStorageKey = 'ph:home:project-positions';
    const status = panel.querySelector<HTMLElement>('.preview-status');
    const links = Array.from(titles.querySelectorAll<HTMLAnchorElement>('a'));
    const firstTitle = links[0];
    const stage = titles.closest<HTMLElement>('.home-stage');
    const targetSelect = panel.querySelector<HTMLSelectElement>('#project-position-target')!;
    const xSlider = panel.querySelector<HTMLInputElement>('#project-position-x')!;
    const ySlider = panel.querySelector<HTMLInputElement>('#project-position-y')!;
    const xValue = panel.querySelector<HTMLOutputElement>('[data-position-x-value]')!;
    const yValue = panel.querySelector<HTMLOutputElement>('[data-position-y-value]')!;
    const editToggle = panel.querySelector<HTMLInputElement>('[data-position-edit]')!;
    type Position = { x: number; y: number };
    const targets = new Map<string, HTMLElement>([['all', titles]]);
    const positions = new Map<string, Position>([['all', { x: 0, y: 0 }]]);
    links.forEach((link) => {
      const key = link.textContent?.trim() ?? '';
      targets.set(key, link);
      positions.set(key, { x: 0, y: 0 });
      targetSelect.add(new Option(key, key));
    });
    let chosenSize: number | null = null;

    const clearStatus = () => { if (status) status.textContent = ''; };
    const persistPositions = () => {
      try { localStorage.setItem(positionStorageKey, JSON.stringify(Object.fromEntries(positions))); } catch {}
    };

    const bounds = (key: string) => {
      const element = targets.get(key)!;
      const position = positions.get(key)!;
      const rectangles = key === 'all' ? links.map(link => link.getBoundingClientRect()) : [element.getBoundingClientRect()];
      const area = stage?.getBoundingClientRect() ?? titles.getBoundingClientRect();
      const left = Math.min(...rectangles.map(rect => rect.left));
      const right = Math.max(...rectangles.map(rect => rect.right));
      const top = Math.min(...rectangles.map(rect => rect.top));
      const bottom = Math.max(...rectangles.map(rect => rect.bottom));
      return {
        minX: Math.min(position.x, Math.ceil(position.x + area.left + 8 - left)),
        maxX: Math.max(position.x, Math.floor(position.x + area.right - 8 - right)),
        minY: Math.min(position.y, Math.ceil(position.y + area.top + 80 - top)),
        maxY: Math.max(position.y, Math.floor(position.y + area.bottom - 16 - bottom)),
      };
    };

    const syncPosition = () => {
      const key = targetSelect.value;
      const position = positions.get(key)!;
      const limits = bounds(key);
      xSlider.min = String(limits.minX);
      xSlider.max = String(limits.maxX);
      ySlider.min = String(limits.minY);
      ySlider.max = String(limits.maxY);
      xSlider.value = String(position.x);
      ySlider.value = String(position.y);
      xValue.value = `${position.x} px`;
      yValue.value = `${position.y} px`;
      links.forEach(link => link.classList.toggle('preview-position-target', targets.get(key) === link));
    };

    const move = (key: string, requested: Position) => {
      const limits = bounds(key);
      const position = {
        x: Math.round(Math.max(limits.minX, Math.min(limits.maxX, requested.x))),
        y: Math.round(Math.max(limits.minY, Math.min(limits.maxY, requested.y))),
      };
      positions.set(key, position);
      targets.get(key)!.style.translate = `${position.x}px ${position.y}px`;
      syncPosition();
      clearStatus();
    };

    const sync = () => {
      if (!firstTitle) return;
      const size = chosenSize ?? Math.round(parseFloat(getComputedStyle(firstTitle).fontSize) * 2) / 2;
      slider.value = String(size);
      value.value = `${size} px`;
      slider.setAttribute('aria-valuetext', `${size} 像素`);
    };

    const apply = (size: number) => {
      chosenSize = size;
      titles.style.setProperty('--project-title-size', `${size}px`);
      sync();
      syncPosition();
    };

    try {
      const saved = localStorage.getItem(storageKey);
      if (saved !== null) {
        const size = Number(saved);
        if (Number.isFinite(size) && size >= 10 && size <= 40) apply(size);
      }
    } catch { /* Preview still works when storage is unavailable. */ }

    try {
      const saved = JSON.parse(localStorage.getItem(positionStorageKey) ?? '{}');
      for (const [key, element] of targets) {
        const position = saved?.[key];
        if (position && Number.isFinite(position.x) && Number.isFinite(position.y)) {
          const x = Math.round(Math.max(-window.innerWidth, Math.min(window.innerWidth, position.x)));
          const y = Math.round(Math.max(-window.innerHeight, Math.min(window.innerHeight, position.y)));
          positions.set(key, { x, y });
          element.style.translate = `${x}px ${y}px`;
        }
      }
    } catch {}

    targetSelect.addEventListener('change', syncPosition);
    [xSlider, ySlider].forEach(input => input.addEventListener('input', () => {
      move(targetSelect.value, { x: xSlider.valueAsNumber, y: ySlider.valueAsNumber });
      persistPositions();
    }));

    const syncEditMode = () => titles.classList.toggle('is-position-editing', editToggle.checked);
    editToggle.addEventListener('change', syncEditMode);
    titles.addEventListener('click', event => {
      if (!editToggle.checked) return;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, true);

    let drag: { pointer: number; key: string; clientX: number; clientY: number; start: Position } | null = null;
    titles.addEventListener('pointerdown', event => {
      if (!editToggle.checked || event.button !== 0 || !event.isPrimary) return;
      const link = (event.target as Element).closest('a');
      const key = link?.textContent?.trim() ?? 'all';
      if (!targets.has(key)) return;
      event.preventDefault();
      targetSelect.value = key;
      syncPosition();
      drag = { pointer: event.pointerId, key, clientX: event.clientX, clientY: event.clientY, start: { ...positions.get(key)! } };
      titles.setPointerCapture(event.pointerId);
      titles.classList.add('is-position-dragging');
    });
    titles.addEventListener('pointermove', event => {
      if (!drag || event.pointerId !== drag.pointer) return;
      move(drag.key, { x: drag.start.x + event.clientX - drag.clientX, y: drag.start.y + event.clientY - drag.clientY });
    });
    const finishDrag = () => {
      if (!drag) return;
      drag = null;
      titles.classList.remove('is-position-dragging');
      persistPositions();
    };
    titles.addEventListener('pointerup', finishDrag);
    titles.addEventListener('pointercancel', finishDrag);
    titles.addEventListener('lostpointercapture', finishDrag);

    slider.addEventListener('input', () => {
      apply(slider.valueAsNumber);
      clearStatus();
      try { localStorage.setItem(storageKey, String(chosenSize)); } catch {}
    });

    panel.querySelector('[data-font-reset]')?.addEventListener('click', () => {
      chosenSize = null;
      titles.style.removeProperty('--project-title-size');
      try { localStorage.removeItem(storageKey); } catch {}
      positions.forEach((_, key) => {
        positions.set(key, { x: 0, y: 0 });
        targets.get(key)!.style.removeProperty('translate');
      });
      try { localStorage.removeItem(positionStorageKey); } catch {}
      clearStatus();
      sync();
      syncPosition();
    });

    panel.querySelector('[data-font-copy]')?.addEventListener('click', async () => {
      const lines = Array.from(positions, ([key, position]) => `${key === 'all' ? '整个列表' : key}：横向 ${position.x}px，纵向 ${position.y}px`);
      const text = [`项目字号：${value.value}`, `预览尺寸：${window.innerWidth} × ${window.innerHeight}`, ...lines].join('\n');
      try {
        await navigator.clipboard.writeText(text);
        if (status) status.textContent = '已复制字号和所有位置参数。';
      } catch {
        if (status) status.textContent = `复制未成功，可把面板数值发给我。`;
      }
    });

    window.addEventListener('resize', () => { sync(); syncPosition(); });
    sync();
    syncPosition();
    syncEditMode();
    panel.hidden = false;
  }
</script>
